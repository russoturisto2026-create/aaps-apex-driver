<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/atc3_halo_bg"
    android:orientation="vertical">

    <!-- Pull to refresh asks the pump for a status, which is what fills the screen. -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/atc3_swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/atc3_screen_status"
            layout="@layout/atc3_halo_screen_status" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!--
        The pump takes its settings as one packet, so edits are collected here and go together.
        Shown only while the draft differs from what the pump reported.
    -->
    <LinearLayout
        android:id="@+id/atc3_save_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/atc3_halo_card_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/atc3_save_hint"
            style="@style/ATC3.Halo.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            tools:text="2 settings not sent" />

        <Button
            android:id="@+id/atc3_discard_button"
            style="@style/ATC3.Halo.Button.Capsule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/atc3_halo_discard" />

        <Button
            android:id="@+id/atc3_save_button"
            style="@style/ATC3.Halo.Button.Capsule.Filled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/atc3_halo_save" />
    </LinearLayout>

</LinearLayout>
